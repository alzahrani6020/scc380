# Private customer-specific settings; copy to .env and NEVER commit .env
# Create a NEW database. Do not use SCC380's production credentials or data.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_UNIQUE_PASSWORD
DATABASE_URL=postgresql://scc:REPLACE_WITH_RANDOM_UNIQUE_PASSWORD@postgres:5432/scc_main?schema=public
DIRECT_URL=postgresql://scc:REPLACE_WITH_RANDOM_UNIQUE_PASSWORD@postgres:5432/scc_main?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SCC380_ACTIVITY_OWNER_EMAIL=owner@example.com
CORS_ORIGINS=https://scc.example.com
SCC_HTTP_PORT=3000
