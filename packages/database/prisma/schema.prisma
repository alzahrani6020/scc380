generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// PUBLIC SCHEMA - Global / Super Admin
// ============================================================

model Tenant {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  domain        String?   @unique
  type          TenantType @default(SHARED)
  status        TenantStatus @default(ACTIVE)
  plan          PlanType  @default(BASIC)
  vatNumber     String?
  crNumber      String?
  settings      Json?     @default("{}")
  features      String[]  @default([])
  logoUrl       String?
  primaryColor  String?   @default("#0066CC")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  users         User[]
  contacts      Contact[]
  deals         Deal[]
  activities    Activity[]
  invoices      Invoice[]
  invoiceItems  InvoiceItem[]
  employees     Employee[]
  departments   Department[]
  vehicles      Vehicle[]
  fleetTrips    FleetTrip[]
  auditLogs     AuditLog[]
  projects      Project[]
  tasks         Task[]
  payments      Payment[]
  expenses      Expense[]
  chartOfAccounts ChartOfAccount[]
  journalEntries JournalEntry[]
  bankAccounts  BankAccount[]
  purchaseOrders PurchaseOrder[]
  leaves        Leave[]
  attendances   Attendance[]
  payrolls      Payroll[]
  shifts        Shift[]
  drivers       Driver[]
  fleetMaintenances FleetMaintenance[]
  fleetFuelLogs FleetFuelLog[]
  sessions      Session[]
  apiKeys       ApiKey[]
  loginAttempts LoginAttempt[]
  aiConversations AIConversation[]
  aiMessages    AIMessage[]
  templates     Template[]
  notifications Notification[]
  subscriptions Subscription[]
  branches      Branch[]
  alerts        Alert[]
  suppliers     Supplier[]
  supplierInvoices SupplierInvoice[]
  supplierInvoiceItems SupplierInvoiceItem[]
  supplierPayments SupplierPayment[]
  stockTransfers  StockTransfer[]
  stockTransferItems StockTransferItem[]
  products      Product[]
  productCategories ProductCategory[]
  warehouses    Warehouse[]
  stockMovements StockMovement[]
  posSessions   PosSession[]
  posOrders     PosOrder[]
  posOrderItems PosOrderItem[]
  posPayments   PosPayment[]
  fixedAssets   FixedAsset[]
  fixedAssetCategories FixedAssetCategory[]
  depreciationEntries DepreciationEntry[]
  costCenters   CostCenter[]
  financialPeriods FinancialPeriod[]
  zatcaCredential ZatcaCredential?
  dataSubjectConsents DataSubjectConsent[]
  gpsLogs         VehicleGpsLog[]
  driverCompliances DriverCompliance[]
  fleetViolations FleetViolation[]
  tripManifests   TripManifest[]
  properties      Property[]
  units           Unit[]
  leaseContracts  LeaseContract[]
  rentPayments    RentPayment[]
  contractDocuments ContractDocument[]
  propertyExpenses PropertyExpense[]

  @@map("tenants")
}

model ZatcaCredential {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // CSR & Keys
  privateKey    String?  @db.Text
  publicKey     String?  @db.Text
  csrPem        String?  @db.Text

  // CSID from ZATCA
  csid          String?  @db.Text
  secretKey     String?  @db.Text
  complianceToken  String? @db.Text
  productionToken  String? @db.Text

  // OTP from ZATCA portal
  otp           String?
  otpExpiresAt  DateTime?

  // Status
  status        String   @default("PENDING") // PENDING, COMPLIANCE_TESTED, ACTIVE, EXPIRED, REVOKED
  environment   String   @default("SANDBOX") // SANDBOX, PRODUCTION

  // Tracking
  lastRenewedAt DateTime?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("zatca_credentials")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?
  passwordHash  String?
  firstName     String
  lastName      String
  role          UserRole  @default(USER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  keycloakId    String?   @unique
  preferences       Json?     @default("{}")
  twoFactorSecret   String?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorBackupCodes String[] @default([])

  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  sessions      Session[]
  apiKeys       ApiKey[]
  loginAttempts LoginAttempt[]
  notifications Notification[]
  subscriptions Subscription[]
  oauthAccounts OAuthAccount[]
  passwordResets PasswordResetToken[]
  auditLogs     AuditLog[]

  @@index([tenantId])
  @@map("users")
}

model AuditLog {
  id            String    @id @default(cuid())
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String
  entityType    String
  entityId      String?
  oldValues     Json?
  newValues     Json?
  ipAddress     String?
  userAgent     String?
  httpMethod    String?
  httpPath      String?
  requestBody   Json?
  responseStatus Int?
  createdAt     DateTime  @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

model DataSubjectConsent {
  id            String    @id @default(cuid())
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  
  // The person whose data is being processed
  subjectType   String    // EMPLOYEE, CUSTOMER, CONTACT
  subjectId     String
  subjectName   String
  subjectEmail  String?
  subjectPhone  String?
  
  // Consent details
  purpose       String    // HR, CRM, MARKETING, PAYROLL
  purposeAr     String?
  description   String?
  granted       Boolean   @default(true)
  grantedAt     DateTime  @default(now())
  withdrawnAt   DateTime?
  withdrawnBy   String?
  
  // PDPL requirements
  ipAddress     String?
  userAgent     String?
  documentUrl   String?   // URL to signed consent form if applicable
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([subjectType, subjectId])
  @@index([purpose])
  @@index([granted])
  @@map("data_subject_consents")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?

  @@index([email])
  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String   // google, github, etc.
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// ============================================================
// CRM
// ============================================================

model Contact {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type          ContactType @default(CUSTOMER)
  status        ContactStatus @default(ACTIVE)
  firstName     String
  lastName      String
  email         String?
  phone         String?
  phone2        String?
  companyName   String?
  jobTitle      String?
  idNumber      String?
  vatNumber     String?
  crNumber      String?
  address       String?
  city          String?
  region        String?
  zipCode       String?
  country       String?   @default("SA")
  source        LeadSource? @default(OTHER)
  stage         DealStage?  @default(LEAD)
  assignedToId  String?
  customFields  Json?     @default("{}")
  tags          String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([assignedToId])
  @@map("contacts")
}

model Deal {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title         String
  description   String?
  contactId     String
  value         Decimal?  @db.Decimal(18, 2)
  currency      String?   @default("SAR")
  stage         DealStage @default(LEAD)
  probability   Int?      @default(0)
  expectedClose DateTime?
  actualClose   DateTime?
  assignedToId  String?
  pipelineId    String?
  stageOrder    Int?      @default(0)
  customFields  Json?     @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([contactId])
  @@index([stage])
  @@index([assignedToId])
  @@map("deals")
}

model Activity {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type          ActivityType
  subject       String
  description   String?
  contactId     String?
  dealId        String?
  scheduledAt   DateTime?
  completedAt   DateTime?
  assignedToId  String?
  remindAt      DateTime?
  reminded      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([contactId])
  @@index([dealId])
  @@index([assignedToId])
  @@index([scheduledAt])
  @@map("activities")
}

// ============================================================
// ERP / Finance
// ============================================================

model Invoice {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoiceNumber String    @unique
  contactId     String
  type          InvoiceType @default(STANDARD)
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal   @db.Decimal(18, 2)
  taxRate       Decimal?  @default(15) @db.Decimal(5, 2)
  taxAmount     Decimal   @db.Decimal(18, 2)
  discount      Decimal?  @default(0) @db.Decimal(18, 2)
  total         Decimal   @db.Decimal(18, 2)
  currency      String?   @default("SAR")
  issueDate     DateTime  @default(now())
  dueDate       DateTime
  paidAt        DateTime?
  paidAmount    Decimal?  @default(0) @db.Decimal(18, 2)
  zatcaUuid           String?   @unique
  zatcaXmlUrl         String?
  zatcaStatus         ZatcaStatus?
  zatcaSignedXml      String?   @db.Text
  previousInvoiceHash String?   // PIH - Previous Invoice Hash
  digitalSignature    String?   @db.Text
  qrCodeData          String?   @db.Text
  clearanceStatus     String?   // PENDING, CLEARED, REJECTED
  reportingStatus     String?   // PENDING, REPORTED, REJECTED
  notes         String?
  retentionUntil DateTime? // ZATCA: 6-year retention requirement
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items         InvoiceItem[]
  payments      Payment[]

  @@index([tenantId])
  @@index([contactId])
  @@index([status])
  @@index([invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoiceId     String
  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  description   String
  quantity      Decimal   @db.Decimal(18, 4)
  unitPrice     Decimal   @db.Decimal(18, 2)
  discount      Decimal?  @default(0) @db.Decimal(18, 2)
  taxRate       Decimal?  @default(15) @db.Decimal(5, 2)
  total         Decimal   @db.Decimal(18, 2)
  createdAt     DateTime  @default(now())

  @@index([tenantId])
  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_items")
}

model Payment {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoiceId     String?
  invoice       Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount        Decimal   @db.Decimal(18, 2)
  currency      String?   @default("SAR")
  method        PaymentMethod @default(CASH)
  status        PaymentStatus @default(COMPLETED)
  reference     String?
  notes         String?
  paidAt        DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([tenantId])
  @@index([invoiceId])
  @@map("payments")
}

model Expense {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  category      ExpenseCategory @default(OTHER)
  amount        Decimal   @db.Decimal(18, 2)
  currency      String?   @default("SAR")
  description   String
  receiptUrl    String?
  incurredAt    DateTime  @default(now())
  approvedById  String?
  status        ExpenseStatus @default(PENDING)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([category])
  @@map("expenses")
}

model ChartOfAccount {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code          String
  name          String
  type          AccountType
  parentId      String?
  balance       Decimal   @default(0) @db.Decimal(18, 2)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ledgerEntries JournalEntry[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  entryNumber   String    @unique
  date          DateTime  @default(now())
  description   String
  reference     String?
  debitAmount   Decimal   @db.Decimal(18, 2)
  creditAmount  Decimal   @db.Decimal(18, 2)
  accountId     String?
  chartAccount  ChartOfAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  type          JournalType @default(GENERAL)
  status        JournalStatus @default(POSTED)
  createdAt     DateTime  @default(now())

  @@index([tenantId])
  @@index([date])
  @@index([accountId])
  @@map("journal_entries")
}

model BankAccount {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  bankName      String
  accountName   String
  accountNumber String    @unique
  iban          String?
  swiftCode     String?
  currency      String?   @default("SAR")
  balance       Decimal   @default(0) @db.Decimal(18, 2)
  isDefault     Boolean   @default(false)
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@map("bank_accounts")
}

model Supplier {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  nameAr        String?
  code          String    @unique
  taxNumber     String?
  commercialReg String?
  email         String?
  phone         String?
  address       String?
  city          String?
  country       String    @default("SA")
  contactName   String?
  contactPhone  String?
  paymentTerms  Int       @default(30)
  creditLimit   Decimal?  @db.Decimal(18, 2)
  balance       Decimal   @default(0) @db.Decimal(18, 2)
  isActive      Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products      Product[]
  purchaseOrders PurchaseOrder[]
  supplierInvoices SupplierInvoice[]
  supplierPayments SupplierPayment[]

  @@index([tenantId])
  @@index([code])
  @@map("suppliers")
}

model Branch {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  code          String    @unique
  address       String?
  city          String?
  phone         String?
  email         String?
  managerName   String?
  isActive      Boolean   @default(true)
  isMain        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  warehouses    Warehouse[]
  posSessions   PosSession[]
  posOrders     PosOrder[]
  bankAccounts  BankAccount[]

  @@index([tenantId])
  @@index([code])
  @@map("branches")
}

model Alert {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type          String    // LOW_STOCK, OVERDUE_INVOICE, UPCOMING_INVOICE, PENDING_PAYMENT, PENDING_LEAVE
  severity      String    // CRITICAL, WARNING, INFO
  title         String
  message       String
  entityId      String?
  entityType    String?
  actionUrl     String?
  isRead        Boolean   @default(false)
  dismissedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId])
  @@index([type])
  @@index([severity])
  @@index([isRead])
  @@index([createdAt])
  @@map("alerts")
}

model PurchaseOrder {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  poNumber      String    @unique
  vendorId      String?
  supplier      Supplier? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  status        POStatus  @default(DRAFT)
  subtotal      Decimal   @db.Decimal(18, 2)
  taxAmount     Decimal   @default(0) @db.Decimal(18, 2)
  total         Decimal   @db.Decimal(18, 2)
  currency      String?   @default("SAR")
  expectedDelivery DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("purchase_orders")
}

model SupplierInvoice {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoiceNumber String    @unique
  supplierId    String
  supplier      Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  
  issueDate     DateTime  @default(now())
  dueDate       DateTime?
  subtotal      Decimal   @db.Decimal(18, 2)
  taxAmount     Decimal   @default(0) @db.Decimal(18, 2)
  total         Decimal   @db.Decimal(18, 2)
  paidAmount    Decimal   @default(0) @db.Decimal(18, 2)
  status        SupplierInvoiceStatus @default(UNPAID)
  
  items         SupplierInvoiceItem[]
  payments      SupplierPayment[]
  
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([supplierId])
  @@index([status])
  @@map("supplier_invoices")
}

model SupplierInvoiceItem {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  supplierInvoiceId String
  supplierInvoice   SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  
  description   String
  quantity      Int       @default(1)
  unitPrice     Decimal   @db.Decimal(18, 4)
  total         Decimal   @db.Decimal(18, 2)
  
  createdAt     DateTime  @default(now())
  
  @@index([tenantId])
  @@index([supplierInvoiceId])
  @@map("supplier_invoice_items")
}

model SupplierPayment {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  supplierId    String
  supplier      Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierInvoiceId String?
  supplierInvoice   SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id], onDelete: SetNull)
  
  amount        Decimal   @db.Decimal(18, 2)
  method        String    @default("BANK_TRANSFER")
  reference     String?
  paymentDate   DateTime  @default(now())
  notes         String?
  createdAt     DateTime  @default(now())
  
  @@index([tenantId])
  @@index([supplierId])
  @@index([supplierInvoiceId])
  @@map("supplier_payments")
}

// ============================================================
// HR
// ============================================================

model Employee {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  employeeCode  String    @unique
  firstName     String
  lastName      String
  email         String?   @unique
  phone         String?
  idNumber      String?   @unique
  nationality   String?   @default("SA")
  departmentId  String?
  jobTitle      String?
  employmentType EmploymentType @default(FULL_TIME)
  status        EmployeeStatus @default(ACTIVE)
  hireDate      DateTime
  terminationDate DateTime?
  basicSalary   Decimal?  @db.Decimal(18, 2)
  housingAllowance Decimal? @db.Decimal(18, 2)
  transportAllowance Decimal? @db.Decimal(18, 2)
  otherAllowances Decimal? @db.Decimal(18, 2)
  gosiNumber    String?
  gosiSalary    Decimal?  @db.Decimal(18, 2)
  emergencyContactName String?
  emergencyContactPhone String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  leaves        Leave[]
  attendances   Attendance[]
  payrolls      Payroll[]
  shifts        Shift[]

  @@index([tenantId])
  @@map("employees")
}

model Department {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  code          String?   @unique
  parentId      String?
  managerId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@map("departments")
}

model Leave {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          LeaveType @default(ANNUAL)
  startDate     DateTime
  endDate       DateTime
  days          Int
  reason        String?
  status        LeaveStatus @default(PENDING)
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@map("leaves")
}

model Attendance {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime  @default(now())
  checkIn       DateTime?
  checkOut      DateTime?
  checkInLat    Decimal?  @db.Decimal(10, 8)
  checkInLng    Decimal?  @db.Decimal(11, 8)
  checkOutLat   Decimal?  @db.Decimal(10, 8)
  checkOutLng   Decimal?  @db.Decimal(11, 8)
