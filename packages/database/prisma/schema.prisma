// ============================================================
// Templates Library
// ============================================================

model Template {
  id            String    @id @default(cuid())
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  nameAr        String?
  category      TemplateCategory
  subcategory   String?
  description   String?
  templateKey   String    @unique
  htmlTemplate  String    @db.Text
  cssStyles     String?   @db.Text
  dataBindings  Json?     @default("{}")
  defaultData   Json?     @default("{}")
  paperSize     String?   @default("A4")
  orientation   String?   @default("portrait")
  isActive      Boolean   @default(true)
  isSystem      Boolean   @default(false)
  sortOrder     Int       @default(0)
  icon          String?   @default("FileText")
  tags          String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([category])
  @@index([templateKey])
  @@map("templates")
}

enum TemplateCategory {
  HR
  ACCOUNTING
  ADMIN
  LEGAL
  FLEET
  SALES
  PROJECTS
}

// ============================================================
// INVENTORY / PRODUCTS
// ============================================================

model ProductCategory {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  code          String?
  description   String?
  parentId      String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products      Product[]

  @@index([tenantId])
  @@map("product_categories")
}

model Product {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  nameAr        String?
  sku           String    @unique
  barcode       String?   @unique
  categoryId    String?
  category      ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  unitOfMeasure String    @default("piece")
  costPrice     Decimal   @default(0) @db.Decimal(18, 4)
  salePrice     Decimal   @default(0) @db.Decimal(18, 4)
  wholesalePrice Decimal? @db.Decimal(18, 4)
  minStockLevel Int       @default(0)
  currentStock  Int       @default(0)
  isActive      Boolean   @default(true)
  isService     Boolean   @default(false)
  taxRate       Decimal   @default(15) @db.Decimal(5, 2)
  description   String?
  imageUrl      String?
  weightKg      Decimal?  @db.Decimal(10, 3)
  dimensions    Json?     @default("{}")
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stockMovements StockMovement[]
  stockTransferItems StockTransferItem[]
  posOrderItems  PosOrderItem[]
  invoiceItems   InvoiceItem[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([barcode])
  @@map("products")
}

model Warehouse {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  code          String?   @unique
  location      String?
  isActive      Boolean   @default(true)
  isDefault     Boolean   @default(false)
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stockMovements StockMovement[]

  @@index([tenantId])
  @@index([branchId])
  @@map("warehouses")
}

model StockMovement {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId   String?
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  type          StockMovementType
  quantity      Int
  unitCost      Decimal   @default(0) @db.Decimal(18, 4)
  totalCost     Decimal   @default(0) @db.Decimal(18, 2)
  reference     String?   // Invoice number, PO number, etc.
  referenceId   String?
  notes         String?
  
  createdAt     DateTime  @default(now())

  @@index([tenantId])
  @@index([productId])
  @@index([warehouseId])
  @@index([type])
  @@map("stock_movements")
}

enum StockMovementType {
  IN          // استلام بضاعة
  OUT         // صرف بضاعة
  SALE        // بيع
  RETURN      // مرتجع
  ADJUSTMENT  // تسوية جرد
  TRANSFER    // تحويل
}

model StockTransfer {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  transferNumber String   @unique
  fromBranchId  String
  toBranchId    String
  
  status        TransferStatus @default(PENDING)
  
  items         StockTransferItem[]
  
  notes         String?
  requestedBy   String?
  approvedBy    String?
  shippedAt     DateTime?
  receivedAt    DateTime?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  transferId    String
  transfer      StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  quantity      Int
  receivedQty   Int       @default(0)
  unitCost      Decimal   @default(0) @db.Decimal(18, 4)
  notes         String?
  
  createdAt     DateTime  @default(now())
  
  @@index([tenantId])
  @@index([transferId])
  @@index([productId])
  @@map("stock_transfer_items")
}

enum TransferStatus {
  PENDING
  APPROVED
  SHIPPED
  RECEIVED
  REJECTED
  CANCELLED
}

// ============================================================
// POS (POINT OF SALE) / كاشير
// ============================================================

model PosSession {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId        String
  
  openingCash   Decimal   @default(0) @db.Decimal(18, 2)
  closingCash   Decimal?  @db.Decimal(18, 2)
  expectedCash  Decimal?  @db.Decimal(18, 2)
  
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  status        SessionStatus @default(OPEN)
  
  posTerminal   String?   // رقم جهاز الكاشير
  notes         String?
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  
  orders        PosOrder[]

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([branchId])
  @@map("pos_sessions")
}

enum SessionStatus {
  OPEN
  CLOSED
  FORCE_CLOSED
}

model PosOrder {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderNumber   String    @unique
  sessionId     String
  session       PosSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  customerId    String?
  customerName  String?
  customerPhone String?
  
  subtotal      Decimal   @db.Decimal(18, 2)
  discount      Decimal   @default(0) @db.Decimal(18, 2)
  taxRate       Decimal   @default(15) @db.Decimal(5, 2)
  taxAmount     Decimal   @db.Decimal(18, 2)
  total         Decimal   @db.Decimal(18, 2)
  
  status        PosOrderStatus @default(COMPLETED)
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  
  items         PosOrderItem[]
  payments      PosPayment[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
  @@index([sessionId])
  @@index([status])
  @@index([branchId])
  @@map("pos_orders")
}

enum PosOrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

model PosOrderItem {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderId       String
  order         PosOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  
  productName   String
  quantity      Int
  unitPrice     Decimal   @db.Decimal(18, 4)
  discount      Decimal   @default(0) @db.Decimal(18, 2)
  taxRate       Decimal   @default(15) @db.Decimal(5, 2)
  total         Decimal   @db.Decimal(18, 2)
  
  createdAt     DateTime  @default(now())

  @@index([tenantId])
  @@index([orderId])
  @@index([productId])
  @@map("pos_order_items")
}

model PosPayment {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  orderId       String
  order         PosOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  method        PosPaymentMethod
  amount        Decimal   @db.Decimal(18, 2)
  reference     String?   // رقم العملية
  
  createdAt     DateTime  @default(now())

  @@index([tenantId])
  @@index([orderId])
  @@map("pos_payments")
}

enum PosPaymentMethod {
  CASH
  CARD
  MADA
  APPLE_PAY
  STC_PAY
  SADAD
  WALLET
  BANK_TRANSFER
}

// ============================================================
// FIXED ASSETS / الأصول الثابتة
// ============================================================

model FixedAssetCategory {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  code          String?
  depreciationRate Decimal @default(0) @db.Decimal(5, 2)
  usefulLifeYears  Int    @default(5)
  depreciationMethod DepreciationMethod @default(STRAIGHT_LINE)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assets        FixedAsset[]

  @@index([tenantId])
  @@map("fixed_asset_categories")
}

model FixedAsset {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  code          String?   @unique
  categoryId    String
  category      FixedAssetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  acquisitionCost Decimal @db.Decimal(18, 2)
  salvageValue  Decimal   @default(0) @db.Decimal(18, 2)
  usefulLifeYears Int     @default(5)
  depreciationMethod DepreciationMethod @default(STRAIGHT_LINE)
  
  purchaseDate  DateTime
  startDate     DateTime  @default(now())
  status        AssetStatus @default(ACTIVE)
  
  accumulatedDepreciation Decimal @default(0) @db.Decimal(18, 2)
  currentValue  Decimal   @db.Decimal(18, 2)
  
  location      String?
  notes         String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  entries       DepreciationEntry[]

  @@index([tenantId])
  @@index([categoryId])
  @@map("fixed_assets")
}

model DepreciationEntry {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assetId       String
  asset         FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  period        String    // 2026-01
  depreciationAmount Decimal @db.Decimal(18, 2)
  accumulatedDepreciation Decimal @db.Decimal(18, 2)
  bookValue     Decimal   @db.Decimal(18, 2)
  
  postedAt      DateTime  @default(now())

  @@index([tenantId])
  @@index([assetId])
  @@index([period])
  @@map("depreciation_entries")
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
  UNITS_OF_PRODUCTION
}

enum AssetStatus {
  ACTIVE
  DISPOSED
  SOLD
  FULLY_DEPRECIATED
}

