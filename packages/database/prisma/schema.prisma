// ============================================================
// Fleet
// ============================================================

model Vehicle {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  plateNumber   String    @unique
  plateType     PlateType @default(PRIVATE)
  make          String
  model         String
  year          Int?
  color         String?
  vin           String?   @unique
  imei          String?   @unique
  status        VehicleStatus @default(ACTIVE)
  ownershipType OwnershipType @default(OWNED)
  ownerId       String?
  assignedDriverId String?
  istimaraExpiry DateTime?
  insuranceExpiry DateTime?
  periodicInspectionExpiry DateTime?
  fuelType      FuelType @default(PETROL)

  // TGA / Wassl compliance
  tgaOperatingLicense String?   // رخصة التشغيل
  tgaLicenseExpiry DateTime?
  loadCapacityKg  Decimal?  @db.Decimal(10, 2)
  axleCount       Int?
  euroClass       String?   // Euro 2, 3, 4, 5, 6
  vehicleCategory String?   // LIGHT, MEDIUM, HEAVY, TRAILER, TANKER
  maxSpeedLimit   Decimal?  @db.Decimal(5, 2)

  lastLatitude  Decimal?  @db.Decimal(10, 8)
  lastLongitude Decimal?  @db.Decimal(11, 8)
  lastLocationAt DateTime?
  lastSpeed     Decimal?  @db.Decimal(5, 2)
  lastHeading   Decimal?  @db.Decimal(5, 2)

