{
  "name": "@scc/ui",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "pnpm exec tsup src/index.ts --format cjs,esm --dts --external react --external react-dom",
    "dev": "pnpm exec tsup src/index.ts --format cjs,esm --dts --external react --external react-dom --watch",
    "lint": "eslint \"src/**/*.tsx\" --fix"
  },
  "dependencies": {
    "@scc/utils": "workspace:*",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0"
  },
  "dependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
