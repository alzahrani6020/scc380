# ============================================================
# Smart Command Center - Environment Variables
# ============================================================

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scc_main
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=scc-files

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# AI / Ollama
OLLAMA_URL=http://localhost:11434
DEFAULT_MODEL=llama3

# Application Ports
API_PORT=3001
WEB_PORT=3000
ADMIN_PORT=3002
GATEWAY_PORT=3000
AI_SERVICE_PORT=3003

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:3001
BACKEND_URL=http://localhost:3001

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=scc
KEYCLOAK_CLIENT_ID=scc-api
KEYCLOAK_CLIENT_SECRET=change-me

# Government Integrations (Saudi Arabia)
ZATCA_API_KEY=
ABSHER_API_KEY=
MOMRAH_API_KEY=
